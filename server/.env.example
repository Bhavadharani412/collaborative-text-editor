# ─── Server configuration (copy to .env) ───────────────────────
NODE_ENV=development
PORT=3001
CLIENT_ORIGIN=http://localhost:5173

# SQLite persistence file (Issue #4)
DB_PATH=./data/collab.sqlite

# Limits (Issues #3/#4)
MAX_DOC_SIZE=1048576      # max document payload bytes (1 MB)
CHUNK_SIZE=65536          # chunk size for large-document transfer
SAVE_DEBOUNCE_MS=1000     # debounced durable writes

LOG_LEVEL=debug           # fatal | error | warn | info | debug | trace

# Reserved for future milestones:
# JWT_SECRET=change-me    # REQUIRED in production (Issue #8)
# REDIS_URL=redis://localhost:6379   # multi-instance sync (Issue #15)
